### Health check
# @name health
GET {{baseUrl}}/health
Accept: application/json

### Log in and remember the token
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
  // Chaining goes through the script store: kulala-core runs this after the
  // response and substitutes the value as {{TOKEN}} in later requests.
  // `{{login.response.body.$.token}}` does NOT work in kulala 6.x — the
  // request-variable store of kulala-core stays empty.
  client.global.set("TOKEN", response.body.token);
%}

### Reuse the token from the login response
# @name profile
GET {{baseUrl}}/profile
Authorization: Bearer {{TOKEN}}
Accept: application/json
